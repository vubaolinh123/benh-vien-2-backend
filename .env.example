# Chạy cục bộ; production chuyển NODE_ENV và SITE_ORIGIN như bên dưới.
NODE_ENV=development
PORT=4000
# Địa chỉ lắng nghe; đặt 127.0.0.1 khi chạy sau nginx trên cùng máy để cổng API không lộ ra Internet.
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/dai_an
# Secret ngẫu nhiên tối thiểu 48 ký tự, không dùng chung giữa các môi trường.
JWT_SECRET=
SITE_ORIGIN=http://localhost:3000
# Production: NODE_ENV=production và SITE_ORIGIN=https://benhviendaian.vn
# 0 khi trực tiếp; 1 khi qua Caddy. Docker Compose đặt giá trị này thành 1.
TRUST_PROXY=0
UPLOAD_DIR=./uploads
# Điền trước khi chạy npm run seed; không có tài khoản/mật khẩu mặc định.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Quản trị viên"
# Tùy chọn chống spam; cần bật cả khóa frontend và backend.
TURNSTILE_SECRET_KEY=
# Chỉ dùng khi triển khai Docker/Caddy, cần trỏ DNS về máy chủ API.
API_DOMAIN=api.benhviendaian.vn
